{
    "name": "cboxdk/cbox-engine",
    "description": "The engine behind the cbox CLI and the Cbox Local desktop app \u2014 one local Kubernetes cluster running an application the way production does.",
    "type": "library",
    "keywords": [
        "kubernetes",
        "kind",
        "local-development",
        "docker",
        "laravel",
        "cbox",
        "platform",
        "developer-experience",
        "gateway-api",
        "scale-to-zero",
        "paas",
        "preview-environments"
    ],
    "homepage": "https://github.com/cboxdk/cbox-engine",
    "license": "MIT",
    "authors": [
        {
            "name": "Cbox",
            "homepage": "https://cboxdk.com"
        }
    ],
    "support": {
        "issues": "https://github.com/cboxdk/cbox-engine/issues",
        "source": "https://github.com/cboxdk/cbox-engine",
        "security": "https://github.com/cboxdk/cbox-engine/security/policy"
    },
    "require": {
        "php": "^8.3",
        "cboxdk/platform": "^0.11.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/process": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Engine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Engine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Engine\\EngineServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "qa": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}